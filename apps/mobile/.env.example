# API base URL as seen from the device/emulator.
# Android emulator -> host machine is 10.0.2.2; a physical device needs your LAN IP or a tunnel.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Optional: EAS project id for builds and push notifications.
EAS_PROJECT_ID=
# Map provider for route maps: google (react-native-maps; Apple Maps on iOS). See components/map.
EXPO_PUBLIC_MAP_PROVIDER=google
# Android Google Maps SDK key (build-time; restrict it to the app package/SHA-1).
GOOGLE_MAPS_ANDROID_KEY=
