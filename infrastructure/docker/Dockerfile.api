# syntax=docker/dockerfile:1.7
# WalkTogether API + background worker (one image, three roles).
#
# Build from the REPOSITORY ROOT (the server bundles shared code from packages/):
#   docker build -f infrastructure/docker/Dockerfile.api -t walktogether-api .
# Run as:
#   API     (default)  node dist/main.js
#   Worker             node dist/worker.js
#   Migrate (release)  npx prisma migrate deploy
FROM node:25-trixie-slim@sha256:aabbe39553d15ede8a97cc60c9e1a97034ff772afcf696ea42b94e7f5f2ec71b AS base
ENV CHECKPOINT_DISABLE=1 NPM_CONFIG_UPDATE_NOTIFIER=false
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
# Only the manifests npm needs to install the server workspace (other apps are not copied).
COPY package.json package-lock.json .npmrc tsconfig.base.json ./
COPY server/package.json server/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/validation/package.json packages/validation/
COPY packages/shared-utils/package.json packages/shared-utils/
COPY packages/api-client/package.json packages/api-client/

FROM base AS build
RUN --mount=type=cache,target=/root/.npm npm ci -w @walktogether/server
COPY packages packages
COPY server server
RUN npm run db:generate && npm run build -w @walktogether/server

# Production dependencies only (shared packages are bundled into dist/ by tsup).
FROM base AS prod-deps
RUN --mount=type=cache,target=/root/.npm npm ci -w @walktogether/server --omit=dev
COPY server/prisma server/prisma
RUN cd server && npx prisma generate

FROM node:25-trixie-slim@sha256:aabbe39553d15ede8a97cc60c9e1a97034ff772afcf696ea42b94e7f5f2ec71b AS runtime
# Debian security updates are applied at build time; the CI Trivy gate blocks unpatched CRITICALs.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends openssl ca-certificates tini ffmpeg && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production CHECKPOINT_DISABLE=1
WORKDIR /app
COPY --from=prod-deps --chown=node:node /repo/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/server/dist ./dist
COPY --chown=node:node server/prisma ./prisma
COPY --chown=node:node server/package.json ./package.json
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:4000/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
# Override with ["node", "dist/worker.js"] for the background worker,
# or ["npx", "prisma", "migrate", "deploy"] for the migration job.
CMD ["node", "dist/main.js"]
