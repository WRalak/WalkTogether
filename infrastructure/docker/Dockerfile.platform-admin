# syntax=docker/dockerfile:1.7
# WalkTogether platform super-admin (admin.) — standalone Next.js server.
#
# Build from the REPOSITORY ROOT (the app imports shared code from packages/):
#   docker build -f infrastructure/docker/Dockerfile.platform-admin -t walktogether-platform-admin .
# NEXT_PUBLIC_* values are inlined at build time, so pass them as --build-arg per environment.
FROM node:25-trixie-slim@sha256:aabbe39553d15ede8a97cc60c9e1a97034ff772afcf696ea42b94e7f5f2ec71b AS build
ENV NEXT_TELEMETRY_DISABLED=1 NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /repo
ARG NEXT_PUBLIC_API_URL
COPY package.json package-lock.json .npmrc tsconfig.base.json ./
COPY packages packages
COPY platform-admin platform-admin
RUN --mount=type=cache,target=/root/.npm npm ci -w @walktogether/platform-admin
RUN npm run build -w @walktogether/platform-admin

FROM node:25-trixie-slim@sha256:aabbe39553d15ede8a97cc60c9e1a97034ff772afcf696ea42b94e7f5f2ec71b AS runtime
# Debian security updates are applied at build time; the CI Trivy gate blocks unpatched CRITICALs.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /repo/platform-admin/.next/standalone ./
COPY --from=build --chown=node:node /repo/platform-admin/.next/static ./platform-admin/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["node", "platform-admin/server.js"]
