# Public URL of the WalkTogether API (browser-visible).
NEXT_PUBLIC_API_URL=http://localhost:4000
# API URL used for server-side rendering (can be an internal address, e.g. http://api:4000 in Docker).
API_INTERNAL_URL=http://localhost:4000
# Canonical public URL of this website (used for sitemap, Open Graph and canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL of the club administration dashboard (for "Create a club" calls to action).
NEXT_PUBLIC_CLUB_ADMIN_URL=http://localhost:3001
# Contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@walktogether.app
