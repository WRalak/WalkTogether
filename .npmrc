# npm workspaces (see "workspaces" in package.json). Dependencies are hoisted to the root
# node_modules, which is the layout Expo / React Native tooling expects.
engine-strict=true
fund=false
# Supply-chain delay: do not resolve versions published less than 7 days ago (honoured by npm >= 11.10;
# older npm ignores it, and Dependabot applies the same 7-day cooldown to update PRs).
min-release-age=7
