{
  "name": "walktogether",
  "private": true,
  "workspaces": [
    "server",
    "website",
    "club-admin",
    "platform-admin",
    "mobile",
    "packages/*"
  ],
  "version": "0.1.0",
  "description": "WalkTogether \u2014 multi-club fitness social network and SaaS platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter @walktogether/server dev",
    "dev:website": "pnpm --filter @walktogether/website dev",
    "dev:club-admin": "pnpm --filter @walktogether/club-admin dev",
    "dev:platform-admin": "pnpm --filter @walktogether/platform-admin dev",
    "dev:mobile": "pnpm --filter @walktogether/mobile start",
    "db:migrate": "pnpm --filter @walktogether/server db:migrate",
    "db:deploy": "pnpm --filter @walktogether/server db:deploy",
    "db:seed": "pnpm --filter @walktogether/server db:seed",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --parallel lint",
    "build": "pnpm -r build"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "8.5.32",
      "deepmerge-ts@<8": "8.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-qr28-fpjm-wq7f"
      ]
    }
  }
}
