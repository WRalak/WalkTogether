{
  "name": "walktogether",
  "private": true,
  "workspaces": [
    "server",
    "mobile",
    "platform-admin",
    "packages/*"
  ],
  "version": "0.1.0",
  "description": "WalkTogether \u2014 multi-club fitness social network and SaaS platform",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:server": "npm run dev -w @walktogether/server",
    "dev:worker": "npm run dev:worker -w @walktogether/server",
    "dev:platform-admin": "npm run dev -w @walktogether/platform-admin",
    "dev:mobile": "npm run start -w @walktogether/mobile",
    "db:generate": "npm run db:generate -w @walktogether/server",
    "db:migrate": "npm run db:migrate -w @walktogether/server",
    "db:deploy": "npm run db:deploy -w @walktogether/server",
    "db:seed": "npm run db:seed -w @walktogether/server",
    "admin:create": "npm run admin:create -w @walktogether/server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run build --workspaces --if-present",
    "audit:prod": "audit-ci --config audit-ci.jsonc",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css}\""
  },
  "overrides": {
    "postcss@<8.5.18": "8.5.32",
    "deepmerge-ts@<8": "8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "audit-ci": "7.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.72.2"
  }
}
