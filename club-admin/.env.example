# Public URL of the WalkTogether API. Must be same-site with this dashboard in deployed
# environments (e.g. api.walktogether.app and clubs.walktogether.app) so the SameSite=Strict
# refresh cookie is sent.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public marketing site (for links back to club pages).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin of presigned media uploads (S3/R2 bucket endpoint), allowed in the CSP connect-src.
NEXT_PUBLIC_MEDIA_UPLOAD_ORIGIN=
