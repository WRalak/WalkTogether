# WalkTogether monorepo — environment overview
#
# Each application has its own documented .env.example. Copy the ones you need:
#   server/.env.example               -> server/.env            (API + worker: database, Redis, secrets, providers)
#   apps/web/.env.example             -> apps/web/.env.local    (public website)
#   apps/club-admin/.env.example      -> apps/club-admin/.env.local
#   apps/platform-admin/.env.example  -> apps/platform-admin/.env.local
#   apps/mobile/.env.example          -> apps/mobile/.env       (EXPO_PUBLIC_API_URL)
#
# docker-compose.yml uses these local-only defaults for its PostgreSQL/PostGIS and Redis containers:
POSTGRES_USER=walktogether
POSTGRES_PASSWORD=walktogether
POSTGRES_DB=walktogether
#
# Never commit real secrets. In staging/production inject them from a secrets manager.
