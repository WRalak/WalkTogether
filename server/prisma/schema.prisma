// WalkTogether database schema.
//
// Conventions:
// - UUID primary keys (generated by Prisma), snake_case table/column names.
// - Every club-scoped table carries club_id and is queried through the tenant-aware
//   services in src/modules/clubs (see docs/architecture/MULTI_TENANT_DESIGN.md).
// - PostGIS geography columns are declared as Unsupported and accessed with
//   parameterised raw SQL; their GIST indexes live in the migration SQL.
// - audit_logs is append-only, enforced by a database trigger (see migration).
//
// Phase 1 contains identity, profiles, sessions, the club tenancy/RBAC foundation and
// platform administration. Later-phase models are specified in docs/database/DATABASE_DESIGN.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum Visibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum ActivityType {
  WALK
  RUN
  HIKE
}

enum DevicePlatform {
  ios
  android
  web
}

enum AuthMethod {
  PASSWORD
  PHONE_OTP
  GOOGLE
  APPLE
  REFRESH
}

enum OAuthProvider {
  google
  apple
}

enum PhoneOtpPurpose {
  LOGIN
  VERIFY
}

enum ClubVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum ClubCategory {
  WALKING
  RUNNING
  HIKING
  MIXED_FITNESS
  CORPORATE_WELLNESS
  CHARITY
  SCHOOL_UNIVERSITY
  OTHER
}

enum ClubStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  LEFT
  REMOVED
  BANNED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity & accounts
// ---------------------------------------------------------------------------

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String?    @unique @db.VarChar(254)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  phone               String?    @unique @db.VarChar(20)
  phoneVerifiedAt     DateTime?  @map("phone_verified_at")
  username            String     @unique @db.VarChar(30)
  passwordHash        String?    @map("password_hash")
  status              UserStatus @default(ACTIVE)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until")
  suspendedAt         DateTime?  @map("suspended_at")
  suspensionReason    String?    @map("suspension_reason") @db.VarChar(500)
  deletionRequestedAt DateTime?  @map("deletion_requested_at")
  deletionScheduledAt DateTime?  @map("deletion_scheduled_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  termsAcceptedAt     DateTime?  @map("terms_accepted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  profile              UserProfile?
  privacySettings      UserPrivacySettings?
  notificationSettings UserNotificationSettings?
  sessions             UserSession[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  phoneVerifications   PhoneVerification[]
  oauthAccounts        OAuthAccount[]
  devices              UserDevice[]
  loginEvents          LoginEvent[]
  blocking             UserBlock[]               @relation("Blocker")
  blockedBy            UserBlock[]               @relation("Blocked")
  ownedClubs           Club[]                    @relation("ClubOwner")
  memberships          ClubMembership[]          @relation("MembershipUser")
  reviewedMemberships  ClubMembership[]          @relation("MembershipReviewer")
  createdInvitations   ClubInvitation[]
  announcements        ClubAnnouncement[]
  subscriptions        Subscription[]            @relation("UserSubscriptions")
  notifications        Notification[]
  activities           Activity[]
  goals                PersonalGoal[]
  eventsCreated        Event[]                   @relation("EventCreator")
  eventRegistrations   EventRegistration[]
  eventAttendance      EventAttendance[]         @relation("Attendee")
  posts                Post[]
  comments             Comment[]
  postLikes            PostLike[]
  bookmarks            Bookmark[]
  mediaAssets          MediaAsset[]
  reportsFiled         ContentReport[]           @relation("Reporter")
  conversationMembers  ConversationMember[]
  messages             Message[]
  challengesCreated    Challenge[]               @relation("ChallengeCreator")
  challengeEntries     ChallengeParticipant[]
  achievements         UserAchievement[]
  payments             Payment[]                 @relation("Payer")
  sponsorsOwned        Sponsor[]
  following            Follow[]                  @relation("Follower")
  followers            Follow[]                  @relation("Followee")

  @@index([status])
  @@index([createdAt])
  @@index([username(ops: raw("gin_trgm_ops"))], map: "users_username_trgm", type: Gin)
  @@map("users")
}

model UserProfile {
  userId                 String         @id @map("user_id") @db.Uuid
  displayName            String         @map("display_name") @db.VarChar(60)
  bio                    String?        @db.VarChar(500)
  avatarUrl              String?        @map("avatar_url") @db.VarChar(500)
  location               String?        @db.VarChar(100)
  countryCode            String?        @map("country_code") @db.Char(2)
  fitnessInterests       String[]       @default([]) @map("fitness_interests")
  preferredActivityTypes ActivityType[] @default([]) @map("preferred_activity_types")
  /// Optional, used only for calorie estimates. Never shared.
  weightKg               Float?         @map("weight_kg")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "user_profiles_display_name_trgm", type: Gin)
  @@map("user_profiles")
}

model UserPrivacySettings {
  userId                    String     @id @map("user_id") @db.Uuid
  profileVisibility         Visibility @default(PUBLIC) @map("profile_visibility")
  activityDefaultVisibility Visibility @default(FOLLOWERS) @map("activity_default_visibility")
  showClubs                 Boolean    @default(true) @map("show_clubs")
  showStats                 Boolean    @default(true) @map("show_stats")
  allowFollowRequests       Boolean    @default(true) @map("allow_follow_requests")
  // Privacy-by-default: start/end of routes are hidden unless the user opts out.
  hideStartEndPoints        Boolean    @default(true) @map("hide_start_end_points")
  privacyZoneRadiusMeters   Int        @default(200) @map("privacy_zone_radius_meters")
  updatedAt                 DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}

model UserNotificationSettings {
  userId            String   @id @map("user_id") @db.Uuid
  pushEnabled       Boolean  @default(true) @map("push_enabled")
  emailEnabled      Boolean  @default(true) @map("email_enabled")
  smsEnabled        Boolean  @default(false) @map("sms_enabled")
  newFollower       Boolean  @default(true) @map("new_follower")
  comments          Boolean  @default(true)
  reactions         Boolean  @default(true)
  clubAnnouncements Boolean  @default(true) @map("club_announcements")
  eventReminders    Boolean  @default(true) @map("event_reminders")
  challengeUpdates  Boolean  @default(true) @map("challenge_updates")
  marketing         Boolean  @default(false)
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

/// One row per logged-in device. Refresh tokens rotate within a session (token family).
model UserSession {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  authMethod    AuthMethod      @map("auth_method")
  deviceId      String?         @map("device_id") @db.VarChar(128)
  deviceName    String?         @map("device_name") @db.VarChar(100)
  platform      DevicePlatform?
  appVersion    String?         @map("app_version") @db.VarChar(32)
  ipAddress     String?         @map("ip_address") @db.VarChar(64)
  userAgent     String?         @map("user_agent") @db.VarChar(500)
  createdAt     DateTime        @default(now()) @map("created_at")
  lastUsedAt    DateTime        @default(now()) @map("last_used_at")
  expiresAt     DateTime        @map("expires_at")
  revokedAt     DateTime?       @map("revoked_at")
  revokedReason String?         @map("revoked_reason") @db.VarChar(100)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// Only SHA-256 hashes of refresh tokens are stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String    @db.VarChar(254)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// OTP codes are stored as HMAC hashes, never in plain text.
model PhoneVerification {
  id        String          @id @default(uuid()) @db.Uuid
  phone     String          @db.VarChar(20)
  userId    String?         @map("user_id") @db.Uuid
  purpose   PhoneOtpPurpose
  codeHash  String          @map("code_hash") @db.Char(64)
  attempts  Int             @default(0)
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")
  createdAt DateTime        @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt])
  @@map("phone_verifications")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  email             String?       @db.VarChar(254)
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Push notification targets.
model UserDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  pushToken  String         @unique @map("push_token") @db.VarChar(512)
  platform   DevicePlatform
  deviceId   String?        @map("device_id") @db.VarChar(128)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

/// Login history and suspicious-login signals. Never contains secrets.
model LoginEvent {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  method        AuthMethod
  success       Boolean
  failureReason String?    @map("failure_reason") @db.VarChar(100)
  ipAddress     String?    @map("ip_address") @db.VarChar(64)
  userAgent     String?    @map("user_agent") @db.VarChar(500)
  deviceId      String?    @map("device_id") @db.VarChar(128)
  suspicious    Boolean    @default(false)
  createdAt     DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("login_events")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ---------------------------------------------------------------------------
// Clubs (tenants)
// ---------------------------------------------------------------------------

model Club {
  id               String                                 @id @default(uuid()) @db.Uuid
  slug             String                                 @unique @db.VarChar(50)
  name             String                                 @db.VarChar(80)
  description      String?                                @db.VarChar(2000)
  category         ClubCategory
  visibility       ClubVisibility
  status           ClubStatus                             @default(ACTIVE)
  requiresApproval Boolean                                @default(false) @map("requires_approval")
  logoUrl          String?                                @map("logo_url") @db.VarChar(500)
  coverUrl         String?                                @map("cover_url") @db.VarChar(500)
  websiteUrl       String?                                @map("website_url") @db.VarChar(500)
  socialLinks      Json                                   @default("{}") @map("social_links")
  contactEmail     String?                                @map("contact_email") @db.VarChar(254)
  contactPhone     String?                                @map("contact_phone") @db.VarChar(20)
  city             String?                                @db.VarChar(100)
  countryCode      String?                                @map("country_code") @db.Char(2)
  operatingArea    String?                                @map("operating_area") @db.VarChar(200)
  location         Unsupported("geography(Point, 4326)")?
  ownerId          String                                 @map("owner_id") @db.Uuid
  memberCount      Int                                    @default(0) @map("member_count")
  suspendedAt      DateTime?                              @map("suspended_at")
  suspensionReason String?                                @map("suspension_reason") @db.VarChar(500)
  createdAt        DateTime                               @default(now()) @map("created_at")
  updatedAt        DateTime                               @updatedAt @map("updated_at")
  deletedAt        DateTime?                              @map("deleted_at")

  owner          User                @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  settings       ClubSettings?
  roles          ClubRole[]
  memberships    ClubMembership[]
  invitations    ClubInvitation[]
  announcements  ClubAnnouncement[]
  subscriptions  Subscription[]
  activityShares ActivityClubShare[]
  events         Event[]
  posts          Post[]
  conversations  Conversation[]
  challenges     Challenge[]
  challengeTeams ChallengeClub[]

  @@index([status, visibility])
  @@index([countryCode, category])
  @@index([ownerId])
  @@index([location], map: "clubs_location_gist", type: Gist)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "clubs_name_trgm", type: Gin)
  @@map("clubs")
}

model ClubSettings {
  clubId              String   @id @map("club_id") @db.Uuid
  allowMemberInvites  Boolean  @default(false) @map("allow_member_invites")
  showMemberList      Boolean  @default(true) @map("show_member_list")
  membershipQuestions Json     @default("[]") @map("membership_questions")
  timezone            String   @default("Africa/Nairobi") @db.VarChar(64)
  updatedAt           DateTime @updatedAt @map("updated_at")

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("club_settings")
}

/// Global catalogue of club permission keys (seeded from @walktogether/shared-types).
model ClubPermission {
  key         String @id @db.VarChar(64)
  description String @db.VarChar(255)

  roles ClubRolePermission[]

  @@map("club_permissions")
}

/// Roles are per-club so each tenant can tailor permissions. System roles are created
/// for every club; the OWNER role always holds every permission and cannot be edited.
model ClubRole {
  id          String   @id @default(uuid()) @db.Uuid
  clubId      String   @map("club_id") @db.Uuid
  systemKey   String?  @map("system_key") @db.VarChar(32)
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(255)
  isOwner     Boolean  @default(false) @map("is_owner")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  club        Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  permissions ClubRolePermission[]
  memberships ClubMembership[]
  invitations ClubInvitation[]

  @@unique([clubId, name])
  @@unique([clubId, systemKey])
  // Composite key used by memberships/invitations to guarantee a role belongs to the same club.
  @@unique([id, clubId])
  @@map("club_roles")
}

model ClubRolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(64)

  role       ClubRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission ClubPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("club_role_permissions")
}

model ClubMembership {
  id             String           @id @default(uuid()) @db.Uuid
  clubId         String           @map("club_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus
  requestMessage String?          @map("request_message") @db.VarChar(500)
  statusReason   String?          @map("status_reason") @db.VarChar(300)
  invitationId   String?          @map("invitation_id") @db.Uuid
  joinedAt       DateTime?        @map("joined_at")
  reviewedById   String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  club       Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User            @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: the role must belong to the same club as the membership.
  role       ClubRole        @relation(fields: [roleId, clubId], references: [id, clubId], onDelete: Restrict)
  reviewedBy User?           @relation("MembershipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  invitation ClubInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, status, createdAt])
  @@map("club_memberships")
}

/// Invitation codes are shown once at creation; only a SHA-256 hash is stored.
model ClubInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  clubId      String    @map("club_id") @db.Uuid
  codeHash    String    @unique @map("code_hash") @db.Char(64)
  codeHint    String    @map("code_hint") @db.VarChar(8)
  email       String?   @db.VarChar(254)
  phone       String?   @db.VarChar(20)
  roleId      String?   @map("role_id") @db.Uuid
  maxUses     Int       @default(1) @map("max_uses")
  useCount    Int       @default(0) @map("use_count")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  club        Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role        ClubRole?        @relation(fields: [roleId, clubId], references: [id, clubId], onDelete: Restrict)
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  memberships ClubMembership[]

  @@index([clubId, createdAt])
  @@map("club_invitations")
}

// ---------------------------------------------------------------------------
// Platform administration (separate identity domain from members)
// ---------------------------------------------------------------------------

model AdminUser {
  id                 String      @id @default(uuid()) @db.Uuid
  email              String      @unique @db.VarChar(254)
  displayName        String      @map("display_name") @db.VarChar(80)
  passwordHash       String      @map("password_hash")
  /// AES-256-GCM encrypted TOTP secret.
  mfaSecretEncrypted String?     @map("mfa_secret_encrypted")
  mfaEnabledAt       DateTime?   @map("mfa_enabled_at")
  status             AdminStatus @default(ACTIVE)
  roleId             String      @map("role_id") @db.Uuid
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until")
  lastLoginAt        DateTime?   @map("last_login_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  role     AdminRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions AdminSession[]

  @@map("admin_users")
}

model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(32)
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  permissions AdminRolePermission[]
  admins      AdminUser[]

  @@map("admin_roles")
}

model AdminPermission {
  key         String @id @db.VarChar(64)
  description String @db.VarChar(255)

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(64)

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("admin_role_permissions")
}

model AdminSession {
  id                String    @id @default(uuid()) @db.Uuid
  adminId           String    @map("admin_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash") @db.Char(64)
  /// Previous refresh-token hash, kept to detect replay of a rotated token.
  previousTokenHash String?   @unique @map("previous_token_hash") @db.Char(64)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

/// Append-only. UPDATE/DELETE are rejected by a trigger (see migration SQL).
model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(100)
  targetType String?   @map("target_type") @db.VarChar(50)
  targetId   String?   @map("target_id") @db.VarChar(100)
  clubId     String?   @map("club_id") @db.Uuid
  metadata   Json      @default("{}")
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  requestId  String?   @map("request_id") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@index([targetType, targetId])
  @@index([clubId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model FeatureFlag {
  key               String   @id @db.VarChar(100)
  description       String?  @db.VarChar(255)
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0) @map("rollout_percentage")
  rules             Json     @default("{}")
  updatedById       String?  @map("updated_by_id") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// Phase 2: announcements, subscription plans & entitlements, notifications
// ---------------------------------------------------------------------------

model ClubAnnouncement {
  id          String    @id @default(uuid()) @db.Uuid
  clubId      String    @map("club_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  title       String    @db.VarChar(140)
  body        String    @db.VarChar(5000)
  pinned      Boolean   @default(false)
  publishedAt DateTime  @default(now()) @map("published_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  club   Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clubId, pinned, publishedAt])
  @@map("club_announcements")
}

enum PlanAudience {
  CLUB
  INDIVIDUAL
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  CANCELED
  EXPIRED
}

/// Prices, trials and limits are data managed by platform admins, never code.
model SubscriptionPlan {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique @db.VarChar(50)
  audience    PlanAudience
  name        String          @db.VarChar(80)
  description String?         @db.VarChar(500)
  currency    String          @default("KES") @db.Char(3)
  amountMinor Int             @default(0) @map("amount_minor")
  interval    BillingInterval @default(MONTH)
  trialDays   Int             @default(0) @map("trial_days")
  graceDays   Int             @default(7) @map("grace_days")
  isActive    Boolean         @default(false) @map("is_active")
  /// The free plan applied when a subject has no paid subscription (one per audience).
  isDefault   Boolean         @default(false) @map("is_default")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  entitlements  SubscriptionEntitlement[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model SubscriptionEntitlement {
  planId    String   @map("plan_id") @db.Uuid
  key       String   @db.VarChar(64)
  intLimit  Int?     @map("int_limit")
  boolValue Boolean? @map("bool_value")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, key])
  @@map("subscription_entitlements")
}

/// Club and individual subscriptions are independent: exactly one of club_id / user_id is set.
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  clubId             String?            @map("club_id") @db.Uuid
  userId             String?            @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  graceUntil         DateTime?          @map("grace_until")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  club Club?            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User?            @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([clubId, status])
  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(1000)
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 3: activities & GPS
// ---------------------------------------------------------------------------

enum ActivityStatus {
  RECORDING
  COMPLETED
  DISCARDED
}

/// Personal activity. Owned by the user — never by a club. Clubs see it only via explicit shares.
model Activity {
  id               String                                      @id @default(uuid()) @db.Uuid
  userId           String                                      @map("user_id") @db.Uuid
  /// Client-generated UUID: makes creation idempotent for offline sync retries.
  clientId         String                                      @map("client_id") @db.Uuid
  type             ActivityType
  status           ActivityStatus                              @default(RECORDING)
  title            String?                                     @db.VarChar(120)
  notes            String?                                     @db.VarChar(1000)
  visibility       Visibility                                  @default(FOLLOWERS)
  startedAt        DateTime                                    @map("started_at")
  endedAt          DateTime?                                   @map("ended_at")
  distanceM        Float                                       @default(0) @map("distance_m")
  movingSeconds    Int                                         @default(0) @map("moving_seconds")
  elapsedSeconds   Int                                         @default(0) @map("elapsed_seconds")
  avgPaceSecPerKm  Int?                                        @map("avg_pace_sec_per_km")
  avgSpeedMps      Float?                                      @map("avg_speed_mps")
  maxSpeedMps      Float?                                      @map("max_speed_mps")
  elevationGainM   Int?                                        @map("elevation_gain_m")
  caloriesEstimate Int?                                        @map("calories_estimate")
  pointCount       Int                                         @default(0) @map("point_count")
  /// Simplified display route (encoded polyline) for the OWNER; others get a privacy-trimmed version.
  routePolyline    String?                                     @map("route_polyline")
  route            Unsupported("geography(LineString, 4326)")?
  /// Anti-cheat signals; flagged activities are excluded from leaderboards/challenges.
  flagged          Boolean                                     @default(false)
  flags            Json                                        @default("{}")
  clientStats      Json?                                       @map("client_stats")
  createdAt        DateTime                                    @default(now()) @map("created_at")
  updatedAt        DateTime                                    @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  points     ActivityGpsPoint[]
  clubShares ActivityClubShare[]
  posts      Post[]

  @@unique([userId, clientId])
  @@index([userId, status, startedAt])
  @@index([status, visibility, startedAt])
  @@index([route], map: "activities_route_gist", type: Gist)
  @@map("activities")
}

/// One row per GPS point (never a JSON blob). Consider monthly range partitioning at scale.
model ActivityGpsPoint {
  activityId        String   @map("activity_id") @db.Uuid
  seq               Int
  segment           Int      @default(0)
  recordedAt        DateTime @map("recorded_at")
  lat               Float
  lng               Float
  accuracyM         Float?   @map("accuracy_m")
  altitudeM         Float?   @map("altitude_m")
  altitudeAccuracyM Float?   @map("altitude_accuracy_m")
  speedMps          Float?   @map("speed_mps")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([activityId, seq])
  @@index([recordedAt], map: "activity_gps_points_recorded_brin", type: Brin)
  @@map("activity_gps_points")
}

/// Explicit, revocable sharing of a personal activity with a club the user belongs to.
model ActivityClubShare {
  activityId String   @map("activity_id") @db.Uuid
  clubId     String   @map("club_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([activityId, clubId])
  @@index([clubId, createdAt])
  @@map("activity_club_shares")
}

enum GoalPeriod {
  WEEK
  MONTH
  YEAR
}

enum GoalMetric {
  DISTANCE_M
  ACTIVITIES
  MOVING_SECONDS
}

model PersonalGoal {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  metric       GoalMetric
  period       GoalPeriod
  activityType ActivityType? @map("activity_type")
  target       Int
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("personal_goals")
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

/// Follow graph. Private profiles require approval (PENDING → ACCEPTED).
model Follow {
  followerId String       @map("follower_id") @db.Uuid
  followeeId String       @map("followee_id") @db.Uuid
  status     FollowStatus
  createdAt  DateTime     @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, status, createdAt])
  @@map("follows")
}

// ---------------------------------------------------------------------------
// Phase 4: events & attendance
// ---------------------------------------------------------------------------

enum EventType {
  WALK
  RUN
  HIKE
  CHARITY_WALK
  FITNESS
  SOCIAL
}

enum EventStatus {
  SCHEDULED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  MEMBERS
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

enum RegistrationStatus {
  GOING
  WAITLISTED
  CANCELLED
}

enum AttendanceMethod {
  QR
  ORGANIZER
}

model Event {
  id                   String                                 @id @default(uuid()) @db.Uuid
  clubId               String                                 @map("club_id") @db.Uuid
  createdById          String                                 @map("created_by_id") @db.Uuid
  /// Occurrences of a recurring event share a series id.
  seriesId             String?                                @map("series_id") @db.Uuid
  title                String                                 @db.VarChar(120)
  description          String?                                @db.VarChar(5000)
  type                 EventType
  status               EventStatus                            @default(SCHEDULED)
  visibility           EventVisibility                        @default(MEMBERS)
  startsAt             DateTime                               @map("starts_at")
  endsAt               DateTime                               @map("ends_at")
  timezone             String                                 @default("Africa/Nairobi") @db.VarChar(64)
  meetingPoint         String                                 @map("meeting_point") @db.VarChar(200)
  meetingLat           Float?                                 @map("meeting_lat")
  meetingLng           Float?                                 @map("meeting_lng")
  meetingLocation      Unsupported("geography(Point, 4326)")? @map("meeting_location")
  routeDescription     String?                                @map("route_description") @db.VarChar(2000)
  distanceM            Int?                                   @map("distance_m")
  difficulty           Difficulty                             @default(EASY)
  maxParticipants      Int?                                   @map("max_participants")
  registrationClosesAt DateTime?                              @map("registration_closes_at")
  coverUrl             String?                                @map("cover_url") @db.VarChar(500)
  /// Secret for rotating QR check-in codes (never sent to members).
  checkInSecret        String                                 @map("check_in_secret") @db.VarChar(64)
  cancelReason         String?                                @map("cancel_reason") @db.VarChar(300)
  goingCount           Int                                    @default(0) @map("going_count")
  createdAt            DateTime                               @default(now()) @map("created_at")
  updatedAt            DateTime                               @updatedAt @map("updated_at")

  club          Club                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy     User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  attendance    EventAttendance[]
  reminders     EventReminder[]
  sponsorship   SponsoredEvent?

  @@index([clubId, startsAt])
  @@index([status, visibility, startsAt])
  @@index([seriesId, startsAt])
  @@index([meetingLocation], map: "events_meeting_location_gist", type: Gist)
  @@map("events")
}

model EventRegistration {
  eventId   String             @map("event_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  status    RegistrationStatus
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId, status])
  @@map("event_registrations")
}

/// Proximity to the meeting point is stored as a supporting signal only — never as proof.
model EventAttendance {
  eventId              String           @map("event_id") @db.Uuid
  userId               String           @map("user_id") @db.Uuid
  method               AttendanceMethod
  checkedInAt          DateTime         @default(now()) @map("checked_in_at")
  checkedInById        String?          @map("checked_in_by_id") @db.Uuid
  distanceFromMeetingM Int?             @map("distance_from_meeting_m")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("Attendee", fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, checkedInAt])
  @@map("event_attendance")
}

model EventReminder {
  eventId String   @map("event_id") @db.Uuid
  kind    String   @db.VarChar(16)
  sentAt  DateTime @default(now()) @map("sent_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, kind])
  @@map("event_reminders")
}

// ---------------------------------------------------------------------------
// Phase 5: social community, media, messaging, moderation
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
}

enum MediaPurpose {
  AVATAR
  CLUB_LOGO
  CLUB_COVER
  POST
  EVENT_COVER
}

/// Media lives in object storage (S3/R2); only metadata is stored here.
model MediaAsset {
  id           String       @id @default(uuid()) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  purpose      MediaPurpose
  kind         MediaKind
  status       MediaStatus  @default(PENDING_UPLOAD)
  storageKey   String       @unique @map("storage_key") @db.VarChar(300)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    Int          @map("size_bytes")
  width        Int?
  height       Int?
  /// Processed variants: { thumb: key, medium: key, ... }
  variants     Json         @default("{}")
  rejectReason String?      @map("reject_reason") @db.VarChar(200)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts PostMedia[]

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@map("media_assets")
}

model Post {
  id           String     @id @default(uuid()) @db.Uuid
  authorId     String     @map("author_id") @db.Uuid
  /// Club posts are visible to that club's active members only.
  clubId       String?    @map("club_id") @db.Uuid
  /// Activity posts inherit the activity's visibility and club shares.
  activityId   String?    @unique @map("activity_id") @db.Uuid
  body         String?    @db.VarChar(5000)
  visibility   Visibility @default(FOLLOWERS)
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  hiddenAt     DateTime?  @map("hidden_at")
  hiddenReason String?    @map("hidden_reason") @db.VarChar(200)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  club      Club?       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  activity  Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  media     PostMedia[]
  comments  Comment[]
  likes     PostLike[]
  bookmarks Bookmark[]

  @@index([authorId, createdAt])
  @@index([clubId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  postId   String @map("post_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid
  position Int    @default(0)

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@map("post_media")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  body      String    @db.VarChar(2000)
  likeCount Int       @default(0) @map("like_count")
  hiddenAt  DateTime? @map("hidden_at")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?          @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]         @relation("Replies")
  reactions CommentReaction[]

  @@index([postId, createdAt])
  @@map("comments")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model CommentReaction {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_reactions")
}

model Bookmark {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

enum ReportTarget {
  POST
  COMMENT
  MESSAGE
  USER
  CLUB
  ACTIVITY
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model ContentReport {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @map("reporter_id") @db.Uuid
  targetType ReportTarget @map("target_type")
  targetId   String       @map("target_id") @db.Uuid
  /// Set when the content belongs to a club, so club moderators can act.
  clubId     String?      @map("club_id") @db.Uuid
  reason     String       @db.VarChar(40)
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  resolution String?      @db.VarChar(300)
  reviewedBy String?      @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?    @map("reviewed_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([clubId, status])
  @@map("content_reports")
}

enum ConversationKind {
  DIRECT
  CLUB
  EVENT
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  kind          ConversationKind
  clubId        String?          @map("club_id") @db.Uuid
  eventId       String?          @unique @map("event_id") @db.Uuid
  /// Sorted "userA:userB" for DIRECT conversations (one per pair).
  directKey     String?          @unique @map("direct_key") @db.VarChar(80)
  title         String?          @db.VarChar(120)
  lastMessageAt DateTime?        @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  club     Club?                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]

  @@index([clubId, kind])
  @@map("conversations")
}

model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at")
  mutedAt        DateTime? @map("muted_at")
  joinedAt       DateTime  @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  /// Client-generated id for idempotent sends over flaky connections.
  clientId       String?   @map("client_id") @db.Uuid
  body           String    @db.VarChar(4000)
  hiddenAt       DateTime? @map("hidden_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Phase 6: challenges, leaderboards, achievements
// ---------------------------------------------------------------------------

enum ChallengeScope {
  PLATFORM
  CLUB
  CLUB_VS_CLUB
  SPONSORED
}

enum ChallengeMetric {
  DISTANCE_M
  ACTIVITIES
  MOVING_SECONDS
  ACTIVE_DAYS
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

model Challenge {
  id                String             @id @default(uuid()) @db.Uuid
  scope             ChallengeScope
  clubId            String?            @map("club_id") @db.Uuid
  createdById       String?            @map("created_by_id") @db.Uuid
  createdByAdminId  String?            @map("created_by_admin_id") @db.Uuid
  title             String             @db.VarChar(120)
  description       String?            @db.VarChar(3000)
  metric            ChallengeMetric
  activityTypes     ActivityType[]     @map("activity_types")
  /// Completion target; null = pure competition (leaderboard only).
  target            Int?
  startsAt          DateTime           @map("starts_at")
  endsAt            DateTime           @map("ends_at")
  visibility        EventVisibility    @default(PUBLIC)
  status            ChallengeStatus    @default(ACTIVE)
  isPremium         Boolean            @default(false) @map("is_premium")
  rules             String?            @db.VarChar(5000)
  rewardDescription String?            @map("reward_description") @db.VarChar(500)
  /// Safety: credit at most this much distance per participant per day.
  maxDailyDistanceM Int                @default(42195) @map("max_daily_distance_m")
  sponsorName       String?            @map("sponsor_name") @db.VarChar(120)
  campaign          SponsoredCampaign?
  coverUrl          String?            @map("cover_url") @db.VarChar(500)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  club         Club?                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ChallengeParticipant[]
  teams        ChallengeClub[]
  progress     ChallengeProgress[]
  results      ChallengeResult[]

  @@index([status, scope, endsAt])
  @@index([clubId, status])
  @@map("challenges")
}

/// Clubs competing in a club-vs-club challenge.
model ChallengeClub {
  challengeId String @map("challenge_id") @db.Uuid
  clubId      String @map("club_id") @db.Uuid

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([challengeId, clubId])
  @@map("challenge_clubs")
}

model ChallengeParticipant {
  challengeId         String    @map("challenge_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  /// Team club for club-vs-club challenges.
  teamClubId          String?   @map("team_club_id") @db.Uuid
  /// Privacy-conscious participation: counted, but shown anonymously on leaderboards.
  hideFromLeaderboard Boolean   @default(false) @map("hide_from_leaderboard")
  /// Explicit consent to sponsored-challenge terms (required for SPONSORED challenges).
  consentedAt         DateTime? @map("consented_at")
  progressValue       Int       @default(0) @map("progress_value")
  progressUpdatedAt   DateTime? @map("progress_updated_at")
  completedAt         DateTime? @map("completed_at")
  notifiedHalfway     Boolean   @default(false) @map("notified_halfway")
  joinedAt            DateTime  @default(now()) @map("joined_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([challengeId, progressValue])
  @@index([userId])
  @@map("challenge_participants")
}

/// Daily contributions (enables per-day safety caps and consistency counting).
model ChallengeProgress {
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  day         DateTime @db.Date
  value       Int

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId, day])
  @@map("challenge_progress")
}

/// Final standings snapshot when a challenge ends.
model ChallengeResult {
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rank        Int
  value       Int
  completed   Boolean
  createdAt   DateTime @default(now()) @map("created_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([challengeId, rank])
  @@map("challenge_results")
}

enum LeaderboardScope {
  GLOBAL
  CLUB
}

enum LeaderboardPeriod {
  WEEK
  MONTH
}

/// Materialised leaderboard computed by a background job.
model Leaderboard {
  id           String            @id @default(uuid()) @db.Uuid
  scope        LeaderboardScope
  clubId       String?           @map("club_id") @db.Uuid
  period       LeaderboardPeriod
  periodStart  DateTime          @map("period_start") @db.Date
  activityType ActivityType?     @map("activity_type")
  computedAt   DateTime          @default(now()) @map("computed_at")

  entries LeaderboardEntry[]

  @@unique([scope, clubId, period, periodStart, activityType])
  @@map("leaderboards")
}

model LeaderboardEntry {
  leaderboardId String @map("leaderboard_id") @db.Uuid
  rank          Int
  userId        String @map("user_id") @db.Uuid
  value         Int

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)

  @@id([leaderboardId, userId])
  @@index([leaderboardId, rank])
  @@map("leaderboard_entries")
}

/// Achievement definitions are data, configurable by platform admins.
model FitnessAchievement {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(80)
  description String   @db.VarChar(300)
  icon        String   @default("🏅") @db.VarChar(16)
  rule        Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  awards UserAchievement[]

  @@map("fitness_achievements")
}

model UserAchievement {
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  earnedAt      DateTime @default(now()) @map("earned_at")
  sourceId      String?  @map("source_id") @db.Uuid

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement FitnessAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

// ---------------------------------------------------------------------------
// Phase 7: payments, invoices, promotions, sponsorships
// ---------------------------------------------------------------------------

enum PaymentPurpose {
  SUBSCRIPTION
  SPONSORSHIP
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// A payment is only marked SUCCEEDED from a verified provider confirmation, never from a client.
model Payment {
  id             String         @id @default(uuid()) @db.Uuid
  purpose        PaymentPurpose
  payerUserId    String         @map("payer_user_id") @db.Uuid
  planId         String?        @map("plan_id") @db.Uuid
  subjectClubId  String?        @map("subject_club_id") @db.Uuid
  subjectUserId  String?        @map("subject_user_id") @db.Uuid
  campaignId     String?        @map("campaign_id") @db.Uuid
  promotionCode  String?        @map("promotion_code") @db.VarChar(40)
  amountMinor    Int            @map("amount_minor")
  currency       String         @db.Char(3)
  status         PaymentStatus  @default(PENDING)
  provider       String         @db.VarChar(20)
  providerRef    String?        @map("provider_ref") @db.VarChar(200)
  idempotencyKey String         @map("idempotency_key") @db.VarChar(100)
  phone          String?        @db.VarChar(20)
  failureReason  String?        @map("failure_reason") @db.VarChar(300)
  refundedMinor  Int            @default(0) @map("refunded_minor")
  lastCheckedAt  DateTime?      @map("last_checked_at")
  confirmedAt    DateTime?      @map("confirmed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  payer        User                 @relation("Payer", fields: [payerUserId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  invoice      Invoice?
  refunds      Refund[]
  campaign     SponsoredCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([payerUserId, idempotencyKey])
  @@unique([provider, providerRef])
  @@index([status, createdAt])
  @@index([subjectClubId, createdAt])
  @@index([subjectUserId, createdAt])
  @@map("payments")
}

/// Log of every provider interaction (requests, callbacks, status queries) for reconciliation.
model PaymentTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  kind      String   @db.VarChar(30)
  status    String   @db.VarChar(40)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  number    String   @unique @db.VarChar(30)
  paymentId String   @unique @map("payment_id") @db.Uuid
  billedTo  Json     @map("billed_to")
  lines     Json
  subtotal  Int
  discount  Int      @default(0)
  tax       Int      @default(0)
  total     Int
  currency  String   @db.Char(3)
  issuedAt  DateTime @default(now()) @map("issued_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

enum RefundStatus {
  SUCCEEDED
  PENDING_MANUAL
  FAILED
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  amountMinor Int          @map("amount_minor")
  reason      String       @db.VarChar(300)
  status      RefundStatus
  providerRef String?      @map("provider_ref") @db.VarChar(200)
  adminId     String       @map("admin_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

/// Idempotent webhook processing: each provider event is handled at most once.
model WebhookEvent {
  provider       String    @db.VarChar(20)
  eventId        String    @map("event_id") @db.VarChar(200)
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  receivedAt     DateTime  @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  error          String?   @db.VarChar(300)

  @@id([provider, eventId])
  @@map("webhook_events")
}

model Promotion {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(40)
  description    String?   @db.VarChar(200)
  percentOff     Int?      @map("percent_off")
  amountOffMinor Int?      @map("amount_off_minor")
  planCodes      String[]  @default([]) @map("plan_codes")
  maxRedemptions Int?      @map("max_redemptions")
  redeemed       Int       @default(0)
  expiresAt      DateTime? @map("expires_at")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("promotions")
}

enum SponsorStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

model Sponsor {
  id           String        @id @default(uuid()) @db.Uuid
  ownerUserId  String        @map("owner_user_id") @db.Uuid
  name         String        @db.VarChar(120)
  slug         String        @unique @db.VarChar(60)
  description  String?       @db.VarChar(2000)
  logoUrl      String?       @map("logo_url") @db.VarChar(500)
  websiteUrl   String?       @map("website_url") @db.VarChar(500)
  contactEmail String        @map("contact_email") @db.VarChar(254)
  status       SponsorStatus @default(PENDING_REVIEW)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  owner     User                @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  campaigns SponsoredCampaign[]

  @@map("sponsors")
}

enum CampaignType {
  CHALLENGE
  EVENT
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  ENDED
  REJECTED
  CANCELLED
}

model SponsoredCampaign {
  id               String         @id @default(uuid()) @db.Uuid
  sponsorId        String         @map("sponsor_id") @db.Uuid
  name             String         @db.VarChar(120)
  type             CampaignType
  status           CampaignStatus @default(DRAFT)
  budgetMinor      Int            @map("budget_minor")
  currency         String         @default("KES") @db.Char(3)
  startsAt         DateTime       @map("starts_at")
  endsAt           DateTime       @map("ends_at")
  /// Published rules participants must accept (competition terms, eligibility, data use).
  terms            String         @db.VarChar(10000)
  eligibility      Json           @default("{}")
  prizeDescription String?        @map("prize_description") @db.VarChar(1000)
  /// Challenge configuration used to create the sponsored challenge on activation.
  challengeConfig  Json?          @map("challenge_config")
  challengeId      String?        @unique @map("challenge_id") @db.Uuid
  reviewNote       String?        @map("review_note") @db.VarChar(500)
  paidAt           DateTime?      @map("paid_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  sponsor   Sponsor          @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  challenge Challenge?       @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  events    SponsoredEvent[]
  rewards   CampaignReward[]
  payments  Payment[]

  @@index([sponsorId, status])
  @@index([status, startsAt])
  @@map("sponsored_campaigns")
}

/// A sponsor's offer to sponsor a club event; the club must accept before it is shown.
model SponsoredEvent {
  eventId    String    @id @map("event_id") @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy String?   @map("accepted_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campaign SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("sponsored_events")
}

enum RewardStatus {
  PENDING
  FULFILLED
  FORFEITED
}

model CampaignReward {
  id          String       @id @default(uuid()) @db.Uuid
  campaignId  String       @map("campaign_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  rank        Int?
  description String       @db.VarChar(300)
  status      RewardStatus @default(PENDING)
  fulfilledAt DateTime?    @map("fulfilled_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  campaign SponsoredCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@map("campaign_rewards")
}
