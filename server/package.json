{
  "name": "@walktogether/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "admin:create:prod": "node dist/create-admin.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/s3-request-presigner": "3.1165.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "9.47.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@walktogether/shared-types": "*",
    "@walktogether/shared-utils": "*",
    "@walktogether/validation": "*",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "nodemailer": "10.5.0",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "prom-client": "15.1.3",
    "rate-limit-redis": "4.3.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
