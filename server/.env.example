# =============================================================================
# WalkTogether API — environment configuration
# Copy to server/.env for local development. NEVER commit real secrets.
# In staging/production, inject these from a secrets manager (e.g. AWS Secrets Manager / SSM).
# =============================================================================

# development | test | staging | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (Nginx/ALB) so req.ip is the real client IP.
TRUST_PROXY=1

# PostgreSQL 16 with PostGIS 3. Use a PgBouncer/RDS Proxy URL in production.
DATABASE_URL=postgresql://walktogether:walktogether@localhost:5432/walktogether?schema=public
REDIS_URL=redis://localhost:6379

# --- Secrets (generate each with: openssl rand -base64 48) -------------------
# Signs member access tokens.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
# Signs platform-admin tokens. MUST differ from JWT_ACCESS_SECRET.
JWT_ADMIN_SECRET=dev-only-admin-secret-change-me-0123456789abcdef
# HMAC key for hashing refresh tokens, reset links, OTP codes and invitation codes.
TOKEN_HASH_SECRET=dev-only-token-hash-secret-change-me-0123456789
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts admin MFA secrets at rest.
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# --- Token lifetimes ---------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
ADMIN_SESSION_TTL_HOURS=8

# --- Web / CORS ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Set to the parent domain in deployed envs, e.g. .walktogether.app
COOKIE_DOMAIN=
# Defaults to true in staging/production.
COOKIE_SECURE=false
# Used to build links in emails.
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# --- Email --------------------------------------------------------------------
# console (dev only: prints emails) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=WalkTogether <no-reply@walktogether.app>
# e.g. smtps://USER:PASS@email-smtp.eu-west-1.amazonaws.com:465 (Amazon SES, Postmark, etc.)
SMTP_URL=

# --- SMS (phone OTP) ----------------------------------------------------------
# console (dev only) | africastalking
SMS_PROVIDER=console
# Africa's Talking credentials (use username "sandbox" with a sandbox key for testing).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- OAuth (comma-separated OAuth client IDs whose ID tokens we accept) -------
# Google: web + Android + iOS client IDs from Google Cloud Console.
GOOGLE_CLIENT_IDS=
# Apple: Services ID (web) and app bundle ID (iOS).
APPLE_CLIENT_IDS=

# --- Background jobs ----------------------------------------------------------
# bullmq (requires `pnpm --filter @walktogether/server dev:worker`) | inline (tests only)
QUEUE_DRIVER=bullmq

RATE_LIMIT_ENABLED=true

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
ADMIN_TOTP_ISSUER=WalkTogether Admin
