# =============================================================================
# WalkTogether API — environment configuration
# Copy to server/.env for local development. NEVER commit real secrets.
# In staging/production, inject these from a secrets manager (e.g. AWS Secrets Manager / SSM).
# =============================================================================

# development | test | staging | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Number of reverse proxies in front of the API (Nginx/ALB) so req.ip is the real client IP.
TRUST_PROXY=1

# PostgreSQL 16 with PostGIS 3. Use a PgBouncer/RDS Proxy URL in production.
DATABASE_URL=postgresql://walktogether:walktogether@localhost:5432/walktogether?schema=public
REDIS_URL=redis://localhost:6379

# --- Secrets (generate each with: openssl rand -base64 48) -------------------
# Signs member access tokens.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
# Signs platform-admin tokens. MUST differ from JWT_ACCESS_SECRET.
JWT_ADMIN_SECRET=dev-only-admin-secret-change-me-0123456789abcdef
# HMAC key for hashing refresh tokens, reset links, OTP codes and invitation codes.
TOKEN_HASH_SECRET=dev-only-token-hash-secret-change-me-0123456789
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts admin MFA secrets at rest.
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# --- Token lifetimes ---------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
ADMIN_ACCESS_TOKEN_TTL_SECONDS=600
ADMIN_SESSION_TTL_HOURS=8

# --- Web / CORS ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API with credentials — one per
# separately hosted web app, e.g. https://walktogether.app,https://clubs.walktogether.app,https://admin.walktogether.app
# Every origin must be on the same parent domain as the API (see docs/deployment/HOSTING.md):
# the API warns at start-up about origins where browser sign-in cannot work.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Leave empty: the refresh cookie is then host-only on the API hostname (most restrictive).
COOKIE_DOMAIN=
# Defaults to true in staging/production.
COOKIE_SECURE=false
# Public URL of this API. Email links, invitation links, Stripe returns and the legal pages
# (/legal/privacy, /legal/terms — give these URLs to the app stores) are served from here.
API_PUBLIC_URL=http://localhost:4000
SUPPORT_EMAIL=hello@walktogether.app

# --- Email --------------------------------------------------------------------
# console (dev only: prints emails) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=WalkTogether <no-reply@walktogether.app>
# e.g. smtps://USER:PASS@email-smtp.eu-west-1.amazonaws.com:465 (Amazon SES, Postmark, etc.)
SMTP_URL=

# --- SMS (phone OTP) ----------------------------------------------------------
# console (dev only) | africastalking
SMS_PROVIDER=console
# Africa's Talking credentials (use username "sandbox" with a sandbox key for testing).
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- OAuth (comma-separated OAuth client IDs whose ID tokens we accept) -------
# Google: web + Android + iOS client IDs from Google Cloud Console.
GOOGLE_CLIENT_IDS=
# Apple: Services ID (web) and app bundle ID (iOS).
APPLE_CLIENT_IDS=

# --- Background jobs ----------------------------------------------------------
# bullmq (requires `pnpm --filter @walktogether/server dev:worker`) | inline (tests only)
QUEUE_DRIVER=bullmq

RATE_LIMIT_ENABLED=true

# --- Observability ------------------------------------------------------------
SENTRY_DSN=
ADMIN_TOTP_ISSUER=WalkTogether Admin

# --- Push / media / payments / monitoring (Phases 5–9) -----------------------------
# console (dev only) | expo
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
# local (dev only) | s3   (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=
# none (dev only) | clamav
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Comma-separated: mpesa,stripe  (sandbox = dev/test only)
PAYMENT_PROVIDERS=sandbox
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Long random secret included in the M-Pesa callback URL (openssl rand -hex 24)
MPESA_CALLBACK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAP_PROVIDER=google
# Bearer token for Prometheus scraping of /metrics (unset = disabled)
METRICS_TOKEN=
# M-Pesa reversals (refunds): API operator name and its encrypted security credential (Daraja portal)
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
# Video transcoding binaries (installed in the API image)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
